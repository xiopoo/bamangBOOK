{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": "out",
  "redirects": [
    { "source": "/bloggers/:account/:slug.md", "destination": "/bloggers/:account/:slug", "statusCode": 301 },
    { "source": "/qa/:slug.md", "destination": "/qa/:slug", "statusCode": 301 },
    { "source": "/talks/:slug.md", "destination": "/talks/:slug", "statusCode": 301 },
    { "source": "/interviews/:slug.md", "destination": "/interviews/:slug", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
