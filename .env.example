# ============================================================
# 复利书房环境变量模板（.env.example）
#
# 复制为 .env.local 后按需填写。真实凭据只放本机或部署平台
# （Vercel 项目环境变量），绝不允许提交进 git。
#
# 提交前运行 `npm run scan:secrets` 检查 staged 文件是否混入凭据。
# ============================================================

# —— 生产域名（部署必填）——
# 用于 canonical URL、sitemap、robots.txt 与社交元数据。
# 生产构建（Vercel）缺少此值会直接失败（scripts/prebuild.js E-01 校验），
# 避免 canonical/sitemap 回落到 http://localhost:3000。
NEXT_PUBLIC_SITE_URL=https://fulilab.com

# 基础域名：用于生成巴菲特/芒格子域名链接。
NEXT_PUBLIC_SITE_DOMAIN=fulilab.com

# —— 可选：图片服务凭据（仅供本地脚本使用）——
# 留空即可；如本机脚本需要，只填本机 .env.local，不要提交。
IMA_CLIENT_ID=
IMA_API_KEY=

# —— 可选：日志级别（L-01）——
# 默认：生产只输出 warn/error，开发输出 info。
# 需要调试时设置 LOG_LEVEL=info 或 NEXT_PUBLIC_LOG_LEVEL=debug。
# 可用值：debug | info | warn | error | silent
# LOG_LEVEL=warn
