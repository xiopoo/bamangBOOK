{
  "name": "bamangbook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-archive-index.mjs && node scripts/generate-meetings-index.mjs && next dev",
    "build": "node scripts/prebuild.js && next build && if [ -z \"$VERCEL\" ]; then node scripts/prebuild.js --restore; fi",
    "start": "next start",
    "lint": "next lint",
    "sync-bloggers": "node scripts/sync-bloggers.js",
    "sync-bloggers:auto": "node scripts/sync-bloggers.js --auto",
    "scan:secrets": "node scripts/scan-staged-secrets.mjs",
    "scan:secrets:all": "node scripts/scan-staged-secrets.mjs --all",
    "optimize:images": "node scripts/optimize-images.mjs",
    "generate:cooccurrence": "node scripts/generate-cooccurrence.mjs",
    "index-bloggers": "node scripts/generate-bloggers-index.js",
    "index-bloggers:incr": "node scripts/generate-bloggers-index.js --incremental",
    "audit:editorial": "node scripts/audit-editorial-books.mjs",
    "inventory:dual-volume": "node scripts/inventory-dual-volume.mjs",
    "audit:dual-volume-final": "node scripts/finalize-dual-volume-audit.mjs",
    "derive:editorial": "node scripts/derive-editorial-books.mjs",
    "build:munger-continuous": "node scripts/build-munger-continuous.mjs",
    "audit:munger-continuous": "node scripts/audit-munger-continuous.mjs",
    "build:editorial-pdf": "node scripts/build-editorial-pdfs.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/hast": "^3.0.4",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/unist": "^3.0.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "playwright": "^1.62.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0"
  }
}
